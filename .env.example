
# Lead-Bot (tools/leadbot) — Flow A, Schritt A1
# Token von @BotFather. ALLOWED_IDS: nur diese Telegram-Nutzer werden bedient.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=

# Ausgelagerte Sicherung — Hetzner Storage Box (tools/twenty-backup/README.md).
# Ohne HETZNER_AVV lädt das Skript bewusst nichts hoch.
HETZNER_BOX_USER=
HETZNER_BOX_PATH=/twenty
HETZNER_AVV=
