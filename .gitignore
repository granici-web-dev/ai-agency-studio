# Zugangsdaten — niemals ins Repository
.env
.env.*
!.env.example

# Kundendaten mit Personenbezug — gehören in eine zugriffsbeschränkte Ablage,
# nicht ins Repository (CLAUDE.md §2.7, .claude/standards/PRINCIPLES.md, DSGVO).
# Diese Liste ist die zweite Verteidigungslinie, nicht die erste: solche Dateien
# kommen gar nicht erst in den Ordner.
*.csv
*.xlsx
projects/**/exporte/

# Nachweise sind Belege, keine Quellen: Screenshots und volle Lighthouse-Berichte
# werden bei jedem Lauf neu erzeugt und blaehen die Historie dauerhaft auf.
# Die README im jeweiligen Ordner bleibt versioniert, sie ist das Verzeichnis.
**/nachweise/**/*.png
**/nachweise/**/*.jpg
**/nachweise/**/*.json

.DS_Store
.idea/

# Abhängigkeiten
node_modules/
token.json

# Maschinelle Artefakte — Playwright-Sitzungslogs und Screenshots
.playwright-mcp/
